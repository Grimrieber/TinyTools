<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="WebApplication1.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        .current-link {
            font-weight: 700;         
            color: #0d6efd !important; 
            text-decoration: underline; 
        }

        /* Bright pink ad panels for testing */
        .ad-panel {
            background-color: #ff69b4 !important; /* hot pink */
            color: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 5px;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <form runat="server" class="flex-grow-1 d-flex flex-column">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" href="~/Applications/Calculator.aspx">CalculatorSuite</a>
            </div>
        </nav>

        <!-- Top Ad Panel -->
        <asp:Panel ID="adPanelTop" runat="server" CssClass="ad-panel mb-3" Visible="True">
            TOP AD PANEL - Placeholder
        </asp:Panel>

        <!-- Main Content -->
        <main class="flex-grow-1 my-4 container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

<%--        <!-- Middle Ad Panel -->
        <asp:Panel ID="adPanelMiddle" runat="server" CssClass="ad-panel my-3" Visible="True">
            MIDDLE AD PANEL - Placeholder
        </asp:Panel>--%>

        <!-- Bottom Ad Panel -->
        <asp:Panel ID="adPanelBottom" runat="server" CssClass="ad-panel mt-3" Visible="True">
            BOTTOM AD PANEL - Placeholder
        </asp:Panel>

        <!-- Footer -->
        <footer class="bg-dark text-white mt-auto py-4 text-center">
            &copy; <%= DateTime.Now.Year %> Calculator Suite. All rights reserved.
        </footer>
    </form>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
